{
  "name": "qinpatients",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@reduxjs/toolkit": "^2.7.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "axios": "^1.8.4",
    "query-string": "^9.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "~5.3.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.5.0",
    "uuid": "^11.1.0"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "lint:fsd": "eslint src/ --ext .ts,.tsx --rule 'boundaries/element-types: warn'",
    "lint:check": "eslint src/ --ext .ts,.tsx --format json > lint-report.json 2>&1 || true && node -e \"const r = require('./lint-report.json'); console.log('Total errors:', r.reduce((sum, f) => sum + f.messages.filter(m => m.severity === 2).length, 0)); console.log('Total warnings:', r.reduce((sum, f) => sum + f.messages.filter(m => m.severity === 1).length, 0))\""
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@eslint/js": "^9.26.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
